{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build && node scripts-vercel.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fixzy-api.vercel.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:page((?!assets)[^./]+)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:page.php",
      "destination": "/:page",
      "permanent": true
    }
  ]
}
